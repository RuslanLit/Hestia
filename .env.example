# Hestia backend example environment
# Copy to .env on the server. Do not put real secrets into this file.

# HTTP/WebSocket listen target. Use a number for TCP or a socket path if your
# host routes Node.js apps through a Unix socket.
PORT=3000

# Public server metadata returned by /api/config.
SERVER_NAME=Hestia

# SQLite storage. Keep this path writable by the Node.js process.
DB_FILE=./hestia.sqlite

# Account creation.
REGISTRATION_ENABLED=true
INVITE_ONLY=false
INVITE_CODES=

# Admin endpoints are hidden unless this is set and passed as X-Admin-Token.
ADMIN_TOKEN=change-me

# Offline queue retention.
OFFLINE_TTL_MS=604800000
OFFLINE_QUEUE_RECIPIENT_MAX_MESSAGES=500
OFFLINE_QUEUE_SERVER_MAX_MESSAGES=5000
OFFLINE_QUEUE_RECIPIENT_MAX_BYTES=262144000
OFFLINE_QUEUE_SERVER_MAX_BYTES=1073741824
OFFLINE_QUEUE_RECIPIENT_ATTACHMENT_MAX_BYTES=230686720
OFFLINE_QUEUE_SERVER_ATTACHMENT_MAX_BYTES=838860800
OFFLINE_QUEUE_RECIPIENT_ATTACHMENT_MAX_FILES=20
OFFLINE_QUEUE_SERVER_ATTACHMENT_MAX_FILES=500

# File/media limits.
ATTACHMENT_DOCUMENT_MAX_BYTES=52428800
ATTACHMENT_IMAGE_MAX_BYTES=26214400
ATTACHMENT_VIDEO_MAX_BYTES=209715200
ATTACHMENT_AUDIO_MAX_BYTES=52428800
HARD_ATTACHMENT_MAX_BYTES=209715200
MAX_WS_MESSAGE_BYTES=786432
MAX_TEXT_BYTES=65536

# WebRTC config returned to clients. Public STUN fallback is built in; add TURN
# for reliable calls across mobile networks, CGNAT, strict NAT, and corporate
# firewalls. Format: url|username|credential, separated by commas.
# Supports stun:, turn:, turns:, and TURN transport queries.
# Example:
# TURN_SERVERS=turn:your-domain.com:3478?transport=udp|user|pass,turn:your-domain.com:3478?transport=tcp|user|pass,turns:your-domain.com:5349?transport=tcp|user|pass
TURN_SERVERS=
CALL_VIDEO_WIDTH=640
CALL_VIDEO_HEIGHT=480
CALL_VIDEO_FRAMERATE=24
CALL_VIDEO_MAX_BITRATE_KBPS=700

# Android FCM data push for messages, contact requests, and incoming calls.
# Use one of these service-account inputs. Never commit service account JSON.
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT_JSON=

# Optional static landing/public directory when it is outside the backend root.
PUBLIC_DIR=

# Logging: info or silent.
LOG_LEVEL=info
