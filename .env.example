# Hestia backend example environment
# Do not put real secrets into this file.

# Current backend code defaults to port 3000 in code.
# Keep this here as the documented deployment value.
PORT=3000

SERVER_NAME=Hestia
OFFLINE_TTL_MS=604800000
REGISTRATION_ENABLED=true
INVITE_ONLY=false
INVITE_CODES=
ADMIN_TOKEN=replace-with-admin-token

# Example:
# TURN_SERVERS=turn:turn.your-domain.test:3478|turn-user|turn-password
TURN_SERVERS=
